<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora Glass splash for API 21+. Previously this variant had no logo at
     all, so every modern device launched into a blank background while the
     pre-21 variant showed the mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/aurora_base" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/gather_logo_splash"
            android:scaleType="centerInside" />
    </item>
</layer-list>